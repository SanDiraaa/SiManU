{
  "appId": "com.sandy.pocketledger",
  "appName": "PocketLedger",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": false
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "StatusBar": {
      "backgroundColor": "#0f172a",
      "style": "DARK",
      "overlaysWebView": false
    }
  }
}

